# /etc/instaload/instaload.env — переменные окружения бота (systemd EnvironmentFile).
# Права: chmod 640 root:instaload. Без кавычек, без export.

# ── Обязательно ──────────────────────────────────────────────────────────────
BOT_TOKEN=ВАШ_ТОКЕН_ОТ_BOTFATHER
# Telegram user_id администратора (узнать: @userinfobot). Доступ к /caption /stats /update.
ADMIN_ID=

# ── Cookies (необязательно) ──────────────────────────────────────────────────
# У каждого пользователя свои cookies Instagram — он присылает их боту сам (/cookies).
# Общий файл ниже используется ТОЛЬКО для тех, у кого своих cookies нет (и для постов каналов).
# Формат Netscape. Файл должен быть доступен пользователю instaload на чтение (и запись — для ротации).
IG_COOKIES_SHARED=
# Cookies YouTube против «Sign in to confirm you're not a bot» на IP датацентра.
YT_COOKIES=

# ── Ресурсы ──────────────────────────────────────────────────────────────────
# Воркеров: 1 для 1 vCPU / 512 МБ–1 ГБ, 2 — если 2 vCPU и ≥ 1 ГБ.
WORKERS=1
QUEUE_MAX=20
QUEUE_PER_USER=3
DOWNLOAD_TIMEOUT_SEC=240
FFMPEG_TIMEOUT_SEC=180
MAX_DOWNLOAD_MB=400

# ── YouTube ──────────────────────────────────────────────────────────────────
# 1 — bestvideo+bestaudio с ремуксом ffmpeg (настоящие 480/720p, ремукс -c copy дёшев).
# 0 — только прогрессивные форматы (по сути всегда 360p), ffmpeg для YouTube не нужен.
YT_MERGE=1
DEFAULT_YT_QUALITY=720

# ── Пути (по умолчанию совпадают с install.sh, менять не нужно) ─────────────
#INSTALOAD_DATA_DIR=/var/lib/instaload
#INSTALOAD_TMP_DIR=/var/lib/instaload/tmp
#YTDLP_BIN=/var/lib/instaload/bin/yt-dlp
#FFMPEG_BIN=/opt/instaload/bin/ffmpeg
#FFPROBE_BIN=/opt/instaload/bin/ffprobe

# ── Автообновление yt-dlp (scripts/update_ytdlp.sh) ─────────────────────────
# Канал: stable | nightly | master. nightly нужен, когда Instagram/YouTube что-то поменяли,
# а фикс ещё не в релизе (как в июле 2026).
YTDLP_CHANNEL=stable
# Ссылки для smoke-теста после обновления (через пробел). Если новая версия падает там,
# где старая работала — откат. Instagram-ссылку сюда ставить можно только с IG_COOKIES_SHARED.
SMOKE_URLS=https://www.youtube.com/watch?v=jNQXAC9IVRw

# ── Прочее ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
EASTER_EGG=1
